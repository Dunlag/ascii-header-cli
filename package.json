{
  "name": "ascii-header-cli",
  "version": "0.1.0",
  "description": "Interactive CLI to generate reusable code headers with ASCII art",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ascii-header": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "demo": "tsx src/demo.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "ascii",
    "header",
    "portfolio",
    "typescript",
    "developer-tools",
    "terminal"
  ],
  "author": "Fernando Pinilla Valbuena",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "figlet": "^1.8.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
